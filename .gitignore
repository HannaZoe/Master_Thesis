# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data — raw/interim/processed stay out of git, see data/CLAUDE.md
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Old staging folder for incoming raw field data, now consolidated into
# fieldwork/field_data/raw/ by scripts/import_field_notes.py -- safe to
# delete by hand, kept ignored in the meantime
data/fieldwork/

# Raw field campaign data (photos, device exports) -- same policy as
# data/raw/, just organized under fieldwork/ instead, see fieldwork/CLAUDE.md
fieldwork/field_data/raw/*
!fieldwork/field_data/raw/.gitkeep

# Point cloud / raster formats (in case any land outside data/ by accident)
*.las
*.laz
*.ply
*.e57
*.tif
*.tiff

# Outputs (regenerable from scripts/notebooks)
outputs/figures/*
outputs/maps/*
!outputs/figures/.gitkeep
!outputs/maps/.gitkeep

# QGIS
*.qgz~
*.qgs~
*.gpkg-shm
*.gpkg-wal

# Jupyter
.ipynb_checkpoints/

# OS
Thumbs.db
.DS_Store

# Local editing backups
*.odp.bak

# VS Code (keep shared settings, ignore personal ones)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
