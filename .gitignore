# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data — raw/interim/processed stay out of git, see data/CLAUDE.md
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Staging folder for incoming raw field data -- consolidated into
# data/raw/20260827_field_notes/ by scripts/import_field_notes.py,
# safe to delete once that's confirmed
data/fieldwork/

# Point cloud / raster formats (in case any land outside data/ by accident)
*.las
*.laz
*.ply
*.e57
*.tif
*.tiff

# Outputs (regenerable from scripts/notebooks)
outputs/figures/*
outputs/maps/*
!outputs/figures/.gitkeep
!outputs/maps/.gitkeep

# QGIS
*.qgz~
*.qgs~
*.gpkg-shm
*.gpkg-wal

# Jupyter
.ipynb_checkpoints/

# OS
Thumbs.db
.DS_Store

# Local editing backups
*.odp.bak

# VS Code (keep shared settings, ignore personal ones)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
